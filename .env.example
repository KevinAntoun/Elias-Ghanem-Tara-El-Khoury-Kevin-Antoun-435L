# Copy to .env for local development. Never commit .env.
HOST=127.0.0.1
DATABASE_PATH=database/security_incidents.db
JWT_SECRET=your-generated-secret
#Run this command to generate a local secret for your services : python -c "import secrets; print(secrets.token_urlsafe(48))"

# All services default to 5001 ... 5009. Override individual ports here.
USERS_PORT=5001
ASSETS_PORT=5002
INCIDENTS_PORT=5003
THREATS_PORT=5004
AUDIT_PORT=5005
REPORTS_PORT=5006
VULNERABILITIES_PORT=5007
NOTIFICATIONS_PORT=5008
PLAYBOOKS_PORT=5009

# For services hosted on other machines, override e.g. USERS_SERVICE_URL=http://host:5001
