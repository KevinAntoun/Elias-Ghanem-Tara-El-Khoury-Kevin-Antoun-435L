# Copy to .env for local development. Never commit .env.
HOST=127.0.0.1
DATABASE_PATH=database/security_incidents.db
JWT_SECRET=your-generated-secret
#Run this command to generate a local secret for your services : python -c "import secrets; print(secrets.token_urlsafe(48))"

# All services default to 5001 ... 5009. Override individual ports here.
USERS_PORT=5001
ASSETS_PORT=5002
INCIDENTS_PORT=5003
THREATS_PORT=5004
AUDIT_PORT=5005
REPORTS_PORT=5006
VULNERABILITIES_PORT=5007
NOTIFICATIONS_PORT=5008
PLAYBOOKS_PORT=5009

# For services hosted on other machines, override e.g. USERS_SERVICE_URL=http://host:5001

# Trusted internal producers: generate one DIFFERENT secret per producer and
# destination; configure the same value on the sender and receiving service.
# Do not copy literal placeholder values into a running deployment.
# AUDIT_TOKEN_USERS=<unique-32+-character-secret>
# AUDIT_TOKEN_ASSETS=<unique-32+-character-secret>
# AUDIT_TOKEN_INCIDENTS=<unique-32+-character-secret>
# AUDIT_TOKEN_THREATS=<unique-32+-character-secret>
# AUDIT_TOKEN_REPORTS=<unique-generated-secret>
# AUDIT_TOKEN_VULNERABILITIES=<unique-32+-character-secret>
# AUDIT_TOKEN_NOTIFICATIONS=<unique-32+-character-secret>
# AUDIT_TOKEN_PLAYBOOKS=<unique-32+-character-secret>
# NOTIFICATION_TOKEN_INCIDENTS=<different-32+-character-secret>
# NOTIFICATION_TOKEN_THREATS=<different-32+-character-secret>
# NOTIFICATION_TOKEN_VULNERABILITIES=<different-32+-character-secret>
# Admin/analyst user IDs receiving new Critical threat/vulnerability alerts.
# SECURITY_ALERT_RECIPIENT_IDS=1,2

# Internal domain reference HTTP credentials. Each pair is independently
# generated and configured on the calling and owning service. Different from
# AUDIT_TOKEN_* and NOTIFICATION_TOKEN_*.
# REFERENCE_TOKEN_USERS_ASSETS=<unique-32+-character-secret>
# REFERENCE_TOKEN_INCIDENTS_ASSETS=<unique-32+-character-secret>
# REFERENCE_TOKEN_USERS_INCIDENTS=<unique-32+-character-secret>
# REFERENCE_TOKEN_ASSETS_INCIDENTS=<unique-32+-character-secret>
# REFERENCE_TOKEN_ASSETS_VULNERABILITIES=<unique-32+-character-secret>
# REFERENCE_TOKEN_USERS_NOTIFICATIONS=<unique-32+-character-secret>
# REFERENCE_TOKEN_USERS_AUDIT=<unique-32+-character-secret>
# REFERENCE_TOKEN_USERS_PLAYBOOKS=<unique-32+-character-secret>
